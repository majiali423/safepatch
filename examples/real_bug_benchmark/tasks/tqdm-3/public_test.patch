+from io import StringIO
+
+import pytest
+
+from tqdm import tqdm
+
+
+def truth_value(*args, **kwargs):
+    stream = StringIO()
+    try:
+        kwargs.update(file=stream, disable=True)
+        with tqdm(*args, **kwargs) as progress:
+            return bool(progress)
+    finally:
+        stream.close()
+
+
+def test_bool():
+    assert truth_value(total=10) is True
+    assert truth_value(total=0) is False
+    assert truth_value([]) is False
+    assert truth_value([0]) is True
+    assert truth_value((item for item in [])) is True
+    assert truth_value((item for item in [1, 2, 3])) is True
+    with pytest.raises(TypeError):
+        truth_value()

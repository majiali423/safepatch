+    def __bool__(self):
+        if self.iterable is None and self.total is None:
+            raise TypeError(
+                "bool() of tqdm with neither iterable nor total")
+        if self.iterable is not None:
+            if hasattr(self.iterable, "__len__"):
+                return len(self.iterable) > 0
+            return True
+        return self.total > 0
+
+    def __nonzero__(self):
+        """Python 2 compatibility"""
+        return self.__bool__()
